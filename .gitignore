# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
[Tt]humbs.db
*.pem
*.key
*.cert

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
server.log

# env files (MUST NEVER BE COMMITTED TO GITHUB)
.env*
!.env.example

# vercel & ides
.vercel
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma native binaries & generated engines (must not commit platform .dll.node)
/src/generated/prisma
/src/generated/prisma-v2/*.node
/src/generated/prisma-v2/query_engine*
*.dll.node
*.node

# Large external binaries
cloudflared.exe
*.exe

# User uploads & media files
/public/uploads/
/public/media-vault/
/media-vault/
/uploads/

# Backups & Database dumps (Protects database and business data)
/backups/
/backups-uploaded/
*.json.gz
*.gz
*.tar
*.zip
*.bak
*.sql
*.dump

# Legacy archive folder (contains 320MB of deprecated code and old binaries)
/_archive/

# Local scratch scripts
scratch/
