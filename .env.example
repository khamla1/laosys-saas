# Database connection string (MongoDB)
DATABASE_URL="mongodb://127.0.0.1:27017/saas?replicaSet=rs0"

# Authentication Secrets (generate random strings: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-here"
JWT_SECRET="your-jwt-secret-here"
CRON_SECRET="your-cron-secret-here"

# Email Configuration (Resend)
RESEND_API_KEY="re_your_api_key_here"

# Application URLs
NEXTAUTH_URL="http://localhost:8443"
NEXTAUTH_URL_INTERNAL="http://localhost:8443"
APP_URL="http://localhost:8443"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your-telegram-bot-username"
