generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-v2"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------
enum Role {
  ADMIN
  SELLER
  CASHIER
  USER
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CASHIER
  ACCOUNTANT
  KITCHEN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  PENDING_DELETE
  DELETED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PENDING
}

enum StockMovementType {
  ADD
  REMOVE
  SALE
  ADJUST
  RETURN
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BusinessType {
  RESTAURANT
  SPORTS_CLUB
  RETAIL
  SERVICE
  GENERIC
  COSMETICS
  ELECTRONICS
  FASHION
  CLINIC
}

enum TicketStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_REQUESTED
  MAINTENANCE
}

// ------------------------------------------------------
// USER & NEXTAUTH
// ------------------------------------------------------
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)

  // Security Hardening
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  mfaBackupCodes      String[]  @default([])
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginDevice     String?

  // Personal
  paymentQrCode      String?
  paymentAccountInfo String?
  promptPayId        String?
  lineNotifyToken    String?
  telegramChatId     String?
  telegramEnabled    Boolean @default(false)
  metadata           Json?

  accounts Account[]
  sessions Session[]

  // Multi-Tenancy
  organizations   UserOrganization[]
  employeeProfile EmployeeProfile?
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// MULTI-TENANCY CORE
// ------------------------------------------------------
model Organization {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String       @unique
  logo           String?
  businessType   BusinessType @default(GENERIC)
  metadata       Json?
  enabledModules String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  packageId             String?             @db.ObjectId
  package               Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  subscriptionStatus    SubscriptionStatus?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionExpiresAt DateTime?

  // Relations
  members              UserOrganization[]
  categories           Category[]
  products             Product[]
  orders               Order[]
  transactions         Transaction[]
  shareLinks           ShareLink[]
  coupons              Coupon[]
  stockMovements       StockMovement[]
  auditLogs            AuditLog[]
  settings             Setting[]
  subscriptionRequests SubscriptionRequest[]

  // ERP
  chartOfAccounts ChartOfAccount[]
  journalEntries  JournalEntry[]
  invoices        Invoice[]
  warehouses      Warehouse[]
  purchaseOrders  PurchaseOrder[]
  suppliers       Supplier[]
  employees       EmployeeProfile[]
  storefront      Storefront?

  // Restaurant
  zones          Zone[]
  modifierGroups ModifierGroup[]
  ingredients    Ingredient[]
  recipeItems    RecipeItem[]

  // Services
  resources        ServiceResource[]
  appointments     Appointment[]
  notifications    Notification[]
  repairTickets    RepairTicket[]
  rentalOrders     RentalOrder[]
  coachingClasses  CoachingClass[]
  classEnrollments ClassEnrollment[]
  medicalCertificates MedicalCertificate[]
  clinicRecords       ClinicRecord[]
  mediaGalleries      MediaGallery[]
  warrantyRecords     WarrantyRecord[]
  ambassadors      Ambassador[]
  fittingProfiles  FittingProfile[]
  consignmentItems ConsignmentItem[]
  teamMembers      TeamMember[]
  teamSchedules    TeamSchedule[]

  // Phase 4 Relations
  commissions      Commission[]
  installments     Installment[]
  quotations       Quotation[]
  inventoryBarcodes InventoryBarcode[]
  inventoryExpiries InventoryExpiry[]
  serialNumbers    SerialNumber[]
  shippingRoutes   ShippingRoute[]
  branches         Branch[]
  promotions       Promotion[]
  loyaltyRewards   LoyaltyReward[]
  communityMembers CommunityMember[]
  teamRosters      TeamRoster[]
  facilityBookings FacilityBooking[]
  techSyncs        TechSync[]
  equipmentItems   EquipmentItem[]
  secondHandItems  SecondHandItem[]
  clubs            Club[]
  teams            Team[]
  clubTeamMembers  ClubTeamMember[]
  communityPosts   CommunityPost[]
  communityComments CommunityComment[]
  smartDevices     SmartDevice[]
  agents           Agent[]
}

model UserOrganization {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  organizationId String   @db.ObjectId
  role           OrgRole  @default(STAFF)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ------------------------------------------------------
// RESTAURANT / POS (KDS, Tables, Modifiers)
// ------------------------------------------------------
model Zone {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String // e.g., "Indoor", "Patio"
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tables         Table[]
  @@index([organizationId])
}

model Table {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  name           String // e.g., "Table 1"
  seats          Int         @default(2)
  status         TableStatus @default(AVAILABLE)
  currentOrderId String?     @db.ObjectId

  zoneId String  @db.ObjectId
  zone   Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orders Order[]
  @@index([zoneId])
}

model ModifierGroup {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String // e.g., "Toppings", "Sweetness"
  isRequired     Boolean      @default(false)
  minSelections  Int          @default(0)
  maxSelections  Int?
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  modifiers Modifier[]

  productIds String[]  @db.ObjectId
  products   Product[] @relation(fields: [productIds], references: [id])
  @@index([organizationId])
}

model Modifier {
  id      String        @id @default(auto()) @map("_id") @db.ObjectId
  name    String // e.g., "Cheese", "50%"
  price   Float         @default(0)
  groupId String        @db.ObjectId
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model KitchenTicket {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String       @db.ObjectId
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    TicketStatus @default(PENDING)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ------------------------------------------------------
// SERVICES & BOOKING
// ------------------------------------------------------
model ServiceResource {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String // e.g., "Massage Room 1", "Dr. Smith"
  type           String // e.g., "ROOM", "STAFF"
  organizationId String        @db.ObjectId
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments   Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Appointment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName  String
  customerPhone String?
  startTime     DateTime
  endTime       DateTime
  status        String // "SCHEDULED", "COMPLETED", "CANCELLED"

  resourceId String          @db.ObjectId
  resource   ServiceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([resourceId])
}

// ------------------------------------------------------
// SAAS / SUBSCRIPTION
// ------------------------------------------------------
model Package {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  price          Float
  durationDays   Int
  productLimit   Int
  orderLimit     Int
  staffLimit     Int
  stripePriceId  String?
  isActive       Boolean  @default(true)
  enabledModules String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizations Organization[]
  requests      SubscriptionRequest[]
}

model SubscriptionRequest {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageId      String       @db.ObjectId
  package        Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  paymentSlipUrl String?
  paymentMethod  String       @default("MANUAL")
  paymentStatus  String       @default("PENDING")
  adminNote      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
}

// ------------------------------------------------------
// E-COMMERCE & INVENTORY
// ------------------------------------------------------
model Category {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  image          String?
  status         String       @default("ACTIVE")
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Product {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  category     String?
  price        Float
  stock        Int           @default(0)
  minStock     Int           @default(5)
  status       ProductStatus @default(ACTIVE)
  images       String[]
  reviewImages String[]      @default([])
  metadata     Json?

  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  variants        ProductVariant[]
  orderItems      OrderItem[]
  warehouseStocks Stock[]
  purchaseItems   PurchaseOrderItem[]

  shareLinkIds   String[]        @db.ObjectId
  shareLinks     ShareLink[]     @relation(fields: [shareLinkIds], references: [id])
  stockMovements StockMovement[]

  modifierGroupIds String[]        @db.ObjectId
  modifierGroups   ModifierGroup[] @relation(fields: [modifierGroupIds], references: [id])
  recipeItems      RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
}

model Ingredient {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  sku            String?
  unit           String // kg, g, ml, L, piece
  costPerUnit    Float
  stock          Float        @default(0)
  minStock       Float        @default(0)
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeItems    RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model RecipeItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  productId      String       @db.ObjectId
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId   String       @db.ObjectId
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity       Float // How much of the ingredient is used per 1 product
  
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([ingredientId])
  @@index([organizationId])
}



model ProductVariant {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String?
  name      String // e.g., "Size: M, Color: Red"
  price     Float?
  stock     Int     @default(0)
  barcode   String?
}

model Storefront {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  customDomain   String?      @unique
  theme          String       @default("light")
  bannerUrl      String?
  metadata       Json?
  organizationId String       @unique @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  totalAmount Float
  status      OrderStatus @default(PENDING)
  metadata    Json?

  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tableId String? @db.ObjectId
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  // Customer Info
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerNote    String?

  paymentMethod  String  @default("CASH")
  paymentSlipUrl String?

  couponId       String? @db.ObjectId
  coupon         Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?
  discountAmount Float   @default(0)

  items          OrderItem[]
  transaction    Transaction?
  kitchenTickets KitchenTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model OrderItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Float

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status TicketStatus @default(PENDING) // Track status for Kitchen Display System

  modifiers Json?
  metadata  Json?

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String
  type        String
  value       Float
  minOrderVal Float     @default(0)
  maxDiscount Float?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  usageCount  Int       @default(0)
  maxUsage    Int?

  applicableProductIds String[] @db.ObjectId

  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ------------------------------------------------------
// INVENTORY / WAREHOUSING
// ------------------------------------------------------
model Warehouse {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  location       String?
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock          Stock[]
  createdAt      DateTime     @default(now())
  @@index([organizationId])
}

model Stock {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  productId   String    @db.ObjectId
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  productId      String            @db.ObjectId
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String?           @db.ObjectId
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String            @db.ObjectId
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Int
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([organizationId])
}

model Supplier {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  organizationId String          @db.ObjectId
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId])
}

model PurchaseOrder {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  supplierId     String              @db.ObjectId
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         String // DRAFT, ORDERED, RECEIVED
  totalAmount    Float
  description    String?
  recordedBy     String?
  attachment     String?
  organizationId String              @db.ObjectId
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PurchaseOrderItem[]
  createdAt      DateTime            @default(now())
  @@index([organizationId])
}

model PurchaseOrderItem {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  poId      String        @db.ObjectId
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String        @db.ObjectId
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Float
}

// ------------------------------------------------------
// ACCOUNTING & FINANCE
// ------------------------------------------------------
model ChartOfAccount {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  code           String
  name           String
  type           AccountType
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  journalLines JournalLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([organizationId, code])
}

model JournalEntry {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  date           DateTime
  description    String
  reference      String?
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lines     JournalLine[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([organizationId])
}

model JournalLine {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  entryId     String         @db.ObjectId
  entry       JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String         @db.ObjectId
  account     ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       Float          @default(0)
  credit      Float          @default(0)
  description String?
}

model Invoice {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber  String
  customerId     String?
  customerName   String
  amount         Float
  status         String // PENDING, PAID, OVERDUE
  dueDate        DateTime?
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId])
}

model Transaction {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  status        String
  paymentMethod String
  reference     String?

  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderId String? @unique @db.ObjectId
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ------------------------------------------------------
// HR & PAYROLL
// ------------------------------------------------------
model EmployeeProfile {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @unique @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     String?
  position       String?
  salary         Float?
  joinDate       DateTime?
  attendances    Attendance[]
  @@index([organizationId])
}

model Attendance {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String          @db.ObjectId
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkIn    DateTime
  checkOut   DateTime?
  status     String
}

// ------------------------------------------------------
// MISC
// ------------------------------------------------------
model ShareLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  status    String   @default("ACTIVE")

  productIds String[]  @db.ObjectId
  products   Product[] @relation(fields: [productIds], references: [id])

  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model AuditLog {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  details   String?
  ipAddress String?
  metadata  Json?

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
}

model Setting {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  key            String
  value          String
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

model AccountRequest {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  password     String?
  phone        String?
  address      String?
  businessType BusinessType @default(GENERIC)
  status       String       @default("pending")
  createdAt    DateTime     @default(now())
}

model StripeEvent {
  id        String   @id @map("_id")
  type      String
  createdAt DateTime @default(now())
}

model Notification {
